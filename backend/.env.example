# ================= DATABASE (Supabase PostgreSQL) =================
# Supabase: Project Settings > Database > Connection string > URI
# Replace YOUR_PROJECT_REF, YOUR_DB_PASSWORD and YOUR_REGION.
# If the password has symbols like @ # / : URL-encode them (@ becomes %40).
# Example: postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Leave empty to automatically fall back to local SQLite.
DATABASE_URL=

# ================= SECURITY =================
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ================= AI ASSISTANT (Google Gemini) =================
# Key from aistudio.google.com. Leave empty for basic keyword mode.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: read-only role from supabase/schema.sql (username is ROLE.PROJECT_REF on the pooler)
# AI_DATABASE_URL=postgresql://smartbiz_ai.YOUR_PROJECT_REF:YOUR_AI_ROLE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres